generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum UserStatus {
  ACTIVO
  VERIFICACION
  SUSPENDIDO
}

enum TxType {
  IN
  OUT
}

enum GoalStatus {
  AL_CORRIENTE
  VENCIDA
  ROTA
}

enum Period {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum WithdrawalStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TicketStatus {
  ABIERTO
  CERRADO
}

enum NotificationTone {
  info
  warn
  danger
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String
  name             String
  firstName        String?
  phone            String?
  address          String?
  role             Role       @default(CLIENT)
  status           UserStatus @default(ACTIVO)
  identityVerified Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Balance fields (kept on user — 1:1 simplicity)
  balanceTotal    Decimal @default(0)
  balanceCurrency String  @default("MXN")
  monthChangePct  Decimal @default(0)
  xipeboxTotal    Decimal @default(0)
  hcboxTotal      Decimal @default(0)

  // Campos de auth de Laravel (panel admin web). Comparten esta misma tabla;
  // el backend del móvil no los usa. Se mapean a las columnas snake_case que
  // creó la migración de Laravel.
  emailVerifiedAt        DateTime? @map("email_verified_at")
  rememberToken          String?   @map("remember_token") @db.VarChar(100)
  twoFactorSecret        String?   @map("two_factor_secret")
  twoFactorRecoveryCodes String?   @map("two_factor_recovery_codes")
  twoFactorConfirmedAt   DateTime? @map("two_factor_confirmed_at")

  goals         Goal[]
  transactions  Transaction[]
  notifications Notification[]
  withdrawals   Withdrawal[]
  tickets       SupportTicket[]
}

model Goal {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  photo          String     @default("🎯")
  target         Decimal
  contribution   Decimal
  termMonths     Int
  initialPayment Decimal    @default(0)
  saved          Decimal    @default(0)
  period         Period     @default(MENSUAL)
  status         GoalStatus @default(AL_CORRIENTE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
}

model Transaction {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    TxType
  concept String
  amount  Decimal
  method  String?
  date    DateTime @default(now())

  @@index([userId, date])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  goalTitle String?
  tone      NotificationTone @default(info)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model Withdrawal {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal
  account   String
  status    WithdrawalStatus @default(PENDIENTE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  status    TicketStatus @default(ABIERTO)
  reply     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
}
